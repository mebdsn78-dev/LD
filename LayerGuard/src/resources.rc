#include <winver.h>

// ID 1 = the application icon (lowest ID => Explorer shows it for LayerGuard.exe)
1 ICON "layerguard.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "LayerGuard"
            VALUE "FileDescription", "LayerGuard - 16-layer sandbox manager"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "ProductVersion", "1.1.0.0"
            VALUE "OriginalFilename", "LayerGuard.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
